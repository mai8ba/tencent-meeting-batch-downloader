{
  "manifest_version": 3,
  "name": "腾讯会议录制批量下载助手",
  "version": "1.8.17",
  "description": "腾讯会议批量下载：网页工作台里采集、筛选、勾选、导出，本地正文校验、断点续导。MIT 开源，免费无限制。",
  "permissions": [
    "downloads",
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://meeting.tencent.com/*",
    "https://www.qq.com/*",
    "https://www.baidu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meeting.tencent.com/user-center/meeting-record*"
      ],
      "js": [
        "compat.js",
        "site-adapter.js",
        "own-export.js",
        "content.js",
        "panel.js",
        "batch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meeting.tencent.com/*"
      ],
      "js": [
        "site-adapter.js",
        "shared-core.js",
        "shared-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://meeting.tencent.com/*"
      ],
      "js": [
        "site-adapter.js",
        "shared-observer.js",
        "shared-password.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meeting.tencent.com/cw/*",
        "https://meeting.tencent.com/crm/*"
      ],
      "js": [
        "detail-transcript.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "腾讯会议录制批量下载助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "batch.html",
        "batch.css",
        "panel.css"
      ],
      "matches": [
        "https://meeting.tencent.com/*"
      ],
      "use_dynamic_url": false
    }
  ]
}